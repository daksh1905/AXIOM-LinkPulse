# LinkPulse environment template
# Copy to .env for local development. Never commit the real .env file.
# All values below are placeholders; replace them with your own values.

FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_MASTER_KEY=replace-with-a-different-long-random-admin-key
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=replace-with-a-strong-unique-password

APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Leave DATABASE_URL unset for local SQLite (links.db beside backend.py).
# For PostgreSQL, use a SQLAlchemy URL. The backend converts postgres:// and
# postgresql:// URLs to the Psycopg 3 dialect.
# Never commit a real database URL or password.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Brevo transactional email API over HTTPS (OTP delivery).
# Use a real API key and a sender address verified in Brevo.
BREVO_API_KEY=replace-with-your-brevo-api-key
MAIL_FROM_EMAIL=verified-sender@example.com
MAIL_FROM_NAME=LinkPulse
