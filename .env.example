# =============================================================================
# LinkPulse - Environment Configuration Template
# =============================================================================
# PURPOSE:
#   This file documents the environment variables used to run LinkPulse.
#
# LOCAL SETUP:
#   1. Copy this file and name the copy `.env` in the project root.
#   2. Replace every placeholder with your own local development values.
#   3. Keep `.env` private. The real `.env` must never be committed to Git.
#
# TEAM NOTE:
#   This template is safe to share because its values are examples only.
#   Team members can improve these explanations in separate commits.
# =============================================================================

# --- Application security ----------------------------------------------------
# Flask uses this key to protect session-related data. Use a long, random value.
# Do not reuse the admin key or publish the real value.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Separate key for privileged admin operations. Keep it private and unique.
ADMIN_MASTER_KEY=replace-with-a-different-long-random-admin-key

# Initial/admin account settings, if used by the backend's admin setup.
# Use a dedicated email and a strong, unique password for local development.
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=replace-with-a-strong-unique-password

# --- Local application server -----------------------------------------------
# `development` is for local development; use the deployment's configured
# environment for production. Never enable debug mode on a public deployment.
APP_ENV=development

# Bind to localhost for local-only use. A hosting platform may supply its own
# host/port configuration, so check the deployment settings before changing it.
HOST=127.0.0.1
PORT=8000

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset for local SQLite; the app uses links.db beside
# backend.py. SQLite is convenient for development and does not need a server.
# For PostgreSQL, uncomment the example below and replace all placeholders.
# Never commit a real database URL: it can contain database credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Email verification / OTP delivery --------------------------------------
# LinkPulse uses Brevo's transactional email API over HTTPS to send verification
# codes. Add a valid API key in your private .env file; never paste it into
# source code, screenshots, issues, or a public repository.
BREVO_API_KEY=replace-with-your-brevo-api-key

# This sender address must be verified/configured in your Brevo account.
MAIL_FROM_EMAIL=verified-sender@example.com

# Friendly sender name displayed in the recipient's email client.
MAIL_FROM_NAME=LinkPulse

# =============================================================================
# SECURITY CHECKLIST
#   - Commit `.env.example`, not your real `.env`.
#   - Keep `.env` listed in .gitignore.
#   - Use different, strong secrets for each environment.
#   - If a secret is accidentally exposed, rotate it immediately.
# =============================================================================
