# Copy this file to .env and replace every placeholder before using the app.
# Generate a long, random value for the Flask session-signing secret.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Legacy admin-console key (kept for backwards compatibility with /admin sign-in).
ADMIN_MASTER_KEY=replace-with-a-different-long-random-admin-key

# Credentials used by the homepage login form for automatic admin redirection.
ADMIN_LOGIN_EMAIL=your-admin-email@example.com
ADMIN_LOGIN_PASSWORD=replace-with-a-strong-admin-password

# SQLite is free and is the default. No paid database is required.
# For local SQLite, you can omit DATABASE_URL entirely.
# DATABASE_URL=sqlite:////absolute/path/to/links.db

# Local development defaults.
# Set production values through your hosting provider's environment settings.
APP_ENV=development
HOST=127.0.0.1
PORT=8000