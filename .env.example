# Copy this file to .env and replace every placeholder before using the app.
# Generate a long random value for the Flask session-signing secret.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Legacy admin-console key (kept for backwards compatibility with /admin sign-in).
ADMIN_MASTER_KEY=replace-with-a-different-long-random-admin-key

# Credentials used by the homepage login form for automatic admin redirection.
# Use an email-shaped admin ID because the homepage form validates email format.
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=replace-with-a-strong-unique-password

# SQLite is free and is the default. No paid database is required.
# For local SQLite, you can omit DATABASE_URL entirely.
# DATABASE_URL=sqlite:////absolute/path/to/links.db

# For deployment, set APP_ENV=production and HOST=0.0.0.0 in the hosting environment.
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Brevo SMTP transactional email settings for signup OTP verification.
# Create SMTP credentials in Brevo > Settings > SMTP & API > SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your-brevo-smtp-login
SMTP_KEY=replace-with-your-brevo-smtp-key
# Must be a verified sender in Brevo (not necessarily the SMTP login).
MAIL_FROM_EMAIL=verified-sender@example.com
MAIL_FROM_NAME=LinkPulse
